/**
 * @title Range loops at the int64 edges (1.37.5)
 * @summary for-in over a range yields the same values on both runtimes for
 * ascending, descending, stepped, inclusive and exclusive ranges, including
 * ranges that end at the largest or smallest 64-bit int (no wrap-around), and
 * ranges beyond 64 bits.
 */
import test;

func collect(any r): list<int> {
    list<int> out = [];
    for (i in r) {
        out.push(i);
    }
    return out;
}

class RangeLoopBoundsTest extends test.Test {
    @test
    func ascendingAndDescending(): void {
        this.assertEquals([0, 1, 2, 3], collect(0..<4));
        this.assertEquals([0, 1, 2, 3, 4], collect(0..4));
        this.assertEquals([4, 3, 2, 1, 0], collect(4..0 by -1));
        this.assertEquals([4, 3, 2, 1], collect(4..<0 by -1));
        this.assertEquals([], collect(0..<0));
        this.assertEquals([], collect(4..0));
    }

    @test
    func steppedRanges(): void {
        this.assertEquals([0, 3, 6, 9], collect(0..10 by 3));
        this.assertEquals([10, 7, 4, 1], collect(10..0 by -3));
        this.assertEquals([0, 3, 6, 9], collect(0..<10 by 3));
    }

    @test
    func endsAtLargestInt(): void {
        let top = 9223372036854775807;
        this.assertEquals([top - 2, top - 1, top], collect((top - 2)..top));
        this.assertEquals([top - 2, top - 1], collect((top - 2)..<top));
    }

    @test
    func endsAtSmallestInt(): void {
        let bottom = -9223372036854775807 - 1;
        this.assertEquals([bottom + 2, bottom + 1, bottom], collect((bottom + 2)..bottom by -1));
        let top = 9223372036854775807;
        this.assertEquals([top - 4, top - 2, top], collect((top - 4)..top by 2));
    }

    @test
    func beyondSixtyFourBits(): void {
        let big = 9223372036854775807 + 1;
        this.assertEquals([big, big + 1], collect(big..(big + 1)));
    }

    @test
    func loopVariableArithmetic(): void {
        int sum = 0;
        for (i in 0..<1000) {
            sum += i * 2;
        }
        this.assertEquals(999000, sum);
    }
}
