/**
 * @title Dict literal, method call and cast fast paths keep their semantics
 * @summary Dict literals with string keys, no-argument methods on strings,
 * lists, dicts, sets and bytes, and casts to a value's own type behave as
 * before, including key order, duplicate keys, aliased type names and
 * argument-count errors.
 */
import test;
import bytes;
import async;

type Flag = bool;

string evalLog = "";

func note(string tag, int v): int {
    evalLog = evalLog + tag;
    return v;
}

func castToParam<int>(any v): any { return v as int; }

func castResults(): generator<any> { yield 13 as int; yield 14 as string; }
async func castResult(): any { return 15 as int; }

func castWrapper(callable next): callable {
    return func(any ...args): any { return next(...args) as string; };
}

@castWrapper
func decoratedCast(): any { return 12 as int; }

class Bag {
    list<int> items = [1, 2];
    func length(): int { return 100 + this.items.length(); }
    func get(int i): int { return this.items[i] * 10; }
    func contains(any v): string { return "bag-${v}"; }
}

class Ranked {
    int r;
    func Ranked(int r) { this.r = r; }
    func __lt(Ranked other): bool { return this.r < other.r; }
}

class FastPathsTest extends test.Test {
    @test
    func dictLiteralKeepsFirstPositionAndLastValue(): void {
        let d = {"b": 1, "a": 2, "b": 3};
        this.assertEquals(["b", "a"], d.keys());
        this.assertEquals(3, d["b"]);
    }

    @test
    func dictLiteralEvaluatesValuesInOrder(): void {
        evalLog = "";
        let d = {"z": note("1", 1), "y": note("2", 2), "x": note("3", 3)};
        this.assertEquals("123", evalLog);
        this.assertEquals(["z", "y", "x"], d.keys());
    }

    @test
    func dictLiteralSizesAndGrowth(): void {
        this.assertEquals(1, {"a": 1}.length());
        this.assertEquals(4, {"a": 1, "b": 2, "c": 3, "d": 4}.length());
        let eight = {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6, "g": 7, "h": 8};
        eight["i"] = 9;
        eight.remove("a");
        this.assertEquals(["b", "c", "d", "e", "f", "g", "h", "i"], eight.keys());
        let nine = {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6, "g": 7, "h": 8, "i": 9};
        this.assertEquals(9, nine["i"]);
        let small = {"p": 1};
        small["q"] = 2;
        small["r"] = 3;
        this.assertEquals(["p", "q", "r"], small.keys());
    }

    @test
    func dictLiteralMixedAndStringNumberKeys(): void {
        string k = "dyn";
        let mixed = {"a": 1, k: 2, "${k}x": 3};
        this.assertEquals(["a", "dyn", "dynx"], mixed.keys());
        let numeric = {"1": "s"};
        this.assertEquals("s", numeric["1"]);
        this.assertFalse(numeric.contains(1));
    }

    @test
    func dictLiteralsInEveryContext(): void {
        let maker = func(int v): dict<string, int> { return {"v": v}; };
        this.assertEquals(4, maker(4)["v"]);
        let nested = {"outer": {"inner": {"deep": true}}};
        this.assertTrue(nested["outer"]["inner"]["deep"] as bool);
        let rows = [{"a": 1}, {"a": 2}];
        this.assertEquals(2, rows[1]["a"]);
    }

    @test
    func noArgumentMethodsOnEveryPrimitive(): void {
        set<int> st = {1, 2, 3};
        this.assertEquals(5, "héllo".length());
        this.assertEquals("AB", "ab".upper());
        this.assertEquals(3, [3, 1, 2].length());
        this.assertEquals([2, 1, 3], [3, 1, 2].reversed());
        this.assertEquals(["a", "b"], {"a": 1, "b": 2}.keys());
        this.assertEquals(3, st.length());
        this.assertEquals(2, bytes.fromString("ab").length());
        this.assertTrue("".isEmpty());
    }

    @test
    func noArgumentSortDispatchesToOrderingDunder(): void {
        let ranked = [Ranked(3), Ranked(1), Ranked(2)];
        ranked.sort();
        this.assertEquals(1, ranked[0].r);
        this.assertEquals(3, ranked[2].r);
    }

    @test
    func castsToOwnTypeAndRebinding(): void {
        this.assertEquals(5, 5 as int);
        this.assertEquals("s", "s" as string);
        this.assertEquals(true, true as bool);
        this.assertEquals("5", 5 as string);
        this.assertEquals(true, 5 as Flag);
        this.assertEquals(true, castToParam<bool>(5));
        this.assertThrows(func(): void { let x = "abc" as int; });
    }

    @test
    func castsKeepTargetsAcrossResumptionAndWrappers(): void {
        this.assertEquals(true, castToParam<bool>(3));
        this.assertEquals("3", castToParam<string>(3));
        this.assertEquals(false, castToParam<bool>(0));
        this.assertEquals("12", decoratedCast());
        list<any> results = [];
        for (value in castResults()) { results.push(value); }
        this.assertEquals([13, "14"], results);
        this.assertEquals(15, async.await(castResult()));
        int sum = 0;
        sum += 16 as int;
        this.assertEquals(16, sum);
        this.assertEquals(1.25f, 1.25f as float);
        this.assertEquals(false, false as bool);
        this.assertEquals(9223372036854775808, 9223372036854775808 as int);
    }

    @test
    func argumentCountErrorsNameTheReceiverType(): void {
        try {
            [1].length(1);
            this.fail("expected an error");
        } catch (Error e) {
            this.assertEquals("list.length expects no arguments", e.message);
        }
        try {
            "ab".contains();
            this.fail("expected an error");
        } catch (Error e) {
            this.assertEquals("string.contains expects one argument", e.message);
        }
        try {
            {"a": 1}.clear(1);
            this.fail("expected an error");
        } catch (Error e) {
            this.assertEquals("dict.clear expects no arguments", e.message);
        }
    }

    @test
    func userClassesKeepTheirOwnLengthGetContains(): void {
        let b = Bag();
        this.assertEquals(102, b.length());
        this.assertEquals(20, b.get(1));
        this.assertEquals("bag-3", b.contains(3));
    }

    @test
    func getReturnsNullOutOfRangeButIndexingThrows(): void {
        let xs = [10, 20, 30];
        this.assertEquals(30, xs.get(-1));
        this.assertNull(xs.get(5));
        this.assertNull(xs.get(-9));
        this.assertNull("abc".get(7));
        this.assertNull(bytes.fromString("ab").get(9));
        this.assertThrows(func(): void { let v = xs[5]; });
        this.assertNull({"a": 1}.get("zz"));
        this.assertEquals("two", {2: "two"}.get(2));
    }

    @test
    func unknownMethodsNameTheType(): void {
        try {
            any z = null;
            z.length();
            this.fail("expected an error");
        } catch (Error e) {
            this.assertEquals("unknown method null.length", e.message);
        }
        try {
            any f = func(): int { return 1; };
            f.nope();
            this.fail("expected an error");
        } catch (Error e) {
            this.assertEquals("unknown method func.nope", e.message);
        }
    }

    @test
    func optionalChainingOnHotMethods(): void {
        ?string maybe = null;
        this.assertNull(maybe?.length());
        string some = "abc";
        this.assertEquals(3, some?.length());
    }
}
