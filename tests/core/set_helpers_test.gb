/**
 * @title Set comparison and callback helpers
 * @summary isSubsetOf / isSupersetOf / isDisjointFrom /
 * symmetricDifference, plus filter / map / any / all returning sets or
 * bools. Callbacks run in the same order as toList().
 */
import test;

class SetHelpersTest extends test.Test {
    @test
    func comparisons(): void {
        let s = {1, 2, 3};
        set<int> none = {};
        this.assertTrue({1, 2}.isSubsetOf(s));
        this.assertTrue(none.isSubsetOf(s));
        this.assertFalse(s.isSubsetOf({1}));
        this.assertTrue(s.isSupersetOf({3}));
        this.assertTrue(s.isDisjointFrom({4, 5}));
        this.assertFalse(s.isDisjointFrom({2}));
        this.assertEquals({1, 2, 4}, s.symmetricDifference({3, 4}));
    }

    @test
    func callbacks(): void {
        let s = {1, 2, 3};
        this.assertEquals({2, 3}, s.filter((int x) => x > 1));
        this.assertEquals({0, 1}, s.map((int x) => x % 2));
        this.assertTrue(s.any((int x) => x == 2));
        this.assertFalse(s.all((int x) => x > 1));
    }

    @test
    func callbacksRunInListOrder(): void {
        let s = {3, 1, 2};
        let seen = [];
        s.all((int x) => {
            seen.push(x);
            return true;
        });
        this.assertEquals(s.toList(), seen);
    }

    @test
    func predicateMustReturnBool(): void {
        let s = {1};
        this.assertThrows(() => s.filter((int x) => x));
    }
}
