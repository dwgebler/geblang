/**
 * @title Structured stack trace test
 * @summary Caught errors expose structured frames: the throw site on
 *          the innermost frame, call-site lines on caller frames, a
 *          trailing <top level> frame, tail-recursion expansion, and
 *          <closure> naming for anonymous functions.
 */
import test;
import errors;

func inner(int x): int {
    throw RuntimeError("trace boom");
}

func middle(int x): int {
    return inner(x);
}

func down(int n): int {
    if (n == 0) {
        throw RuntimeError("bottom");
    }
    return down(n - 1);
}

func throwingKey(int x): int {
    if (x == 1) {
        throw RuntimeError("key boom");
    }
    return x;
}

func sortViaCallback(): void {
    let s = [3, 1, 2].sortBy(throwingKey);
}

func nestedInner(int x): int {
    throw RuntimeError("nested key boom");
}

func nestedMid(int x): int {
    let a = [10, 20].map(nestedInner);
    return x;
}

# Separate-VM callback shapes: the callback runs on a fresh wrapper VM, so the caller chain must be stitched back onto its trace.
func sortViaCapturingClosure(): void {
    let tag = 7;
    let s = [3, 1, 2].sortBy(func(int x): int {
        if (x == 1) { throw RuntimeError("cap boom ${tag}"); }
        return x;
    });
}

class TraceKeyer {
    func __invoke(int x): int {
        if (x == 1) { throw RuntimeError("invoke boom"); }
        return x;
    }
}

func sortViaCallableInstance(): void {
    let s = [3, 1, 2].sortBy(TraceKeyer());
}

class UncaughtTraceTest extends test.Test {
    @test
    func framesReflectThrowAndCallSites(): void {
        try {
            middle(5);
        } catch (RuntimeError e) {
            let frames = e.stackTrace().frames();
            this.assertEquals("inner", frames[0].function());
            this.assertEquals(12, frames[0].line());
            this.assertEquals("middle", frames[1].function());
            this.assertEquals(16, frames[1].line());
            let last = frames[frames.length() - 1];
            this.assertEquals("<top level>", last.function());
        }
    }

    @test
    func faultIsClassedRuntimeErrorWithTrace(): void {
        int zero = 0;
        try {
            let x = 10 / zero;
        } catch (RuntimeError e) {
            this.assertEquals("decimal division by zero", e.message);
            this.assertTrue(errors.hasStackTrace(e));
            this.assertTrue(e.stackTrace().length() > 0);
        }
    }

    @test
    func tailRecursiveThrowExpandsRepeatedFrames(): void {
        try {
            down(50);
        } catch (RuntimeError e) {
            let frames = e.stackTrace().frames();
            int downCount = 0;
            for (f in frames) {
                if (f.function() == "down") {
                    downCount = downCount + 1;
                }
            }
            this.assertEquals(51, downCount);
            this.assertEquals("down", frames[0].function());
        }
    }

    @test
    func closureFramesUseClosureName(): void {
        let f = func(int x): int {
            throw RuntimeError("anon boom");
        };
        try {
            f(1);
        } catch (RuntimeError e) {
            this.assertEquals("<closure>", e.stackTrace().first().function());
        }
    }

    @test
    func freshErrorHasNoTraceUntilThrown(): void {
        let e = errors.new("ValueError", "never thrown");
        this.assertFalse(errors.hasStackTrace(e));
    }

    @test
    func nativeCallbackTraceKeepsCallerFrames(): void {
        try {
            sortViaCallback();
        } catch (RuntimeError e) {
            let frames = e.stackTrace().frames();
            this.assertEquals("throwingKey", frames[0].function());
            this.assertEquals(28, frames[0].line());
            # The caller frame's line is the HOF call site, not a stale callback line.
            this.assertEquals("sortViaCallback", frames[1].function());
            this.assertEquals(34, frames[1].line());
            int callerCount = 0;
            for (f in frames) {
                if (f.function() == "sortViaCallback") {
                    callerCount = callerCount + 1;
                }
            }
            this.assertEquals(1, callerCount);
        }
    }

    @test
    func nestedHofTraceCallerLines(): void {
        try {
            let m = [1, 2, 3].map(nestedMid);
        } catch (RuntimeError e) {
            let frames = e.stackTrace().frames();
            # Each caller frame reports its own HOF call site.
            this.assertEquals("nestedInner", frames[0].function());
            this.assertEquals(38, frames[0].line());
            this.assertEquals("nestedMid", frames[1].function());
            this.assertEquals(42, frames[1].line());
        }
    }

    @test
    func capturingClosureTraceKeepsCallerFrames(): void {
        try {
            sortViaCapturingClosure();
        } catch (RuntimeError e) {
            let frames = e.stackTrace().frames();
            this.assertEquals("<closure>", frames[0].function());
            this.assertEquals(50, frames[0].line());
            # The stitched caller frame's line is the HOF call site.
            this.assertEquals("sortViaCapturingClosure", frames[1].function());
            this.assertEquals(49, frames[1].line());
            int callerCount = 0;
            for (f in frames) {
                if (f.function() == "sortViaCapturingClosure") {
                    callerCount = callerCount + 1;
                }
            }
            this.assertEquals(1, callerCount);
        }
    }

    @test
    func callableInstanceTraceKeepsCallerFrames(): void {
        try {
            sortViaCallableInstance();
        } catch (RuntimeError e) {
            let frames = e.stackTrace().frames();
            this.assertEquals("TraceKeyer.__invoke", frames[0].function());
            this.assertEquals(57, frames[0].line());
            this.assertEquals("sortViaCallableInstance", frames[1].function());
            this.assertEquals(63, frames[1].line());
        }
    }
}
