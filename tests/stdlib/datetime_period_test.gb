import datetime;
import datetime.period as period;
import test;

class DatetimePeriodTest extends test.Test {
    @test
    func clampsPeriodMonthEndsAndLeapDays(): void {
        let january = datetime.Instant(2024, 1, 31, 12, 0, 0);
        this.assertEquals("2024-02-29T12:00:00Z",
            period.Period(0, 1).addTo(january).formatRFC3339());
        let leapDay = datetime.Instant(2024, 2, 29);
        this.assertEquals("2025-02-28T00:00:00Z",
            period.Period(1).addTo(leapDay).formatRFC3339());
        this.assertEquals("2024-03-01T12:00:00Z",
            period.Period(0, 2, -30).addTo(january).formatRFC3339());
    }

    @test
    func resolvesSpringGapAndFallFold(): void {
        let spring = datetime.Instant("2024-03-09T07:30:00Z");
        this.assertEquals("2024-03-10T07:00:00Z",
            period.Period(0, 0, 1).addTo(spring, "America/New_York").formatRFC3339());
        let fall = datetime.Instant("2024-11-02T05:30:00Z");
        this.assertEquals("2024-11-03T05:30:00Z",
            period.Period(0, 0, 1).addTo(fall, "America/New_York").formatRFC3339());
    }

    @test
    func skipsInvalidMonthlyDates(): void {
        let schedule = period.Recurrence(datetime.Instant(2024, 1, 31),
            "monthly", {"count": 3});
        list<string> dates = [];
        for (item in schedule.occurrences(10)) { dates.push(item.formatRFC3339()); }
        this.assertEquals(["2024-01-31T00:00:00Z", "2024-03-31T00:00:00Z",
            "2024-05-31T00:00:00Z"], dates);
    }

    @test
    func filtersWeeklyAndHalfOpenBetween(): void {
        let schedule = period.Recurrence(datetime.Instant(2024, 1, 2),
            "weekly", {"weekdays": [1, 3], "count": 4});
        list<string> dates = [];
        for (item in schedule.occurrences(10)) { dates.push(item.formatRFC3339()); }
        this.assertEquals(["2024-01-03T00:00:00Z", "2024-01-08T00:00:00Z",
            "2024-01-10T00:00:00Z", "2024-01-15T00:00:00Z"], dates);
        list<string> window = [];
        for (item in schedule.between(datetime.Instant(2024, 1, 8),
                                      datetime.Instant(2024, 1, 15), 10)) {
            window.push(item.formatRFC3339());
        }
        this.assertEquals(["2024-01-08T00:00:00Z", "2024-01-10T00:00:00Z"], window);
    }

    @test
    func skipsWeekendsAndHolidaysInBothDirections(): void {
        let friday = datetime.Instant(2024, 5, 24, 15, 0, 0);
        this.assertTrue(period.isBusinessDay(friday));
        this.assertEquals("2024-05-28T15:00:00Z",
            period.addBusinessDays(friday, 1, "UTC", ["2024-05-27"]).formatRFC3339());
        this.assertEquals("2024-05-23T15:00:00Z",
            period.addBusinessDays(friday, -1).formatRFC3339());
        this.assertEquals(friday, period.addBusinessDays(friday, 0));
    }

    @test
    func rejectsInvalidOptionsZonesAndHolidays(): void {
        bool badZone = false;
        try { period.Period().addTo(datetime.Instant(0), "Missing/Zone"); }
        catch (Error e) { badZone = true; }
        this.assertTrue(badZone);
        bool badHoliday = false;
        try { period.isBusinessDay(datetime.Instant(0), "UTC", ["2024-02-30"]); }
        catch (ValueError e) { badHoliday = true; }
        this.assertTrue(badHoliday);
        bool badWeekdays = false;
        try { period.Recurrence(datetime.Instant(0), "daily", {"weekdays": [1]}); }
        catch (ValueError e) { badWeekdays = true; }
        this.assertTrue(badWeekdays);
    }

    @test
    func jumpsToDistantRangeAndHonorsInclusiveUntil(): void {
        let daily = period.Recurrence(datetime.Instant(2024, 1, 1),
            "daily", {"interval": 2});
        list<string> distant = [];
        for (item in daily.between(datetime.Instant(2025, 1, 1),
                                   datetime.Instant(2025, 1, 7), 3)) {
            distant.push(item.formatRFC3339());
        }
        this.assertEquals(["2025-01-01T00:00:00Z", "2025-01-03T00:00:00Z",
            "2025-01-05T00:00:00Z"], distant);
        let bounded = period.Recurrence(datetime.Instant(2024, 1, 1), "daily",
            {"until": datetime.Instant(2024, 1, 3)});
        list<string> first = [];
        for (item in bounded.occurrences(10)) { first.push(item.formatRFC3339()); }
        this.assertEquals(["2024-01-01T00:00:00Z", "2024-01-02T00:00:00Z",
            "2024-01-03T00:00:00Z"], first);
    }

    @test
    func keepsWallTimeAcrossDaylightSavingInDailyRecurrence(): void {
        let schedule = period.Recurrence(datetime.Instant("2024-03-09T07:30:00Z"),
            "daily", {"zone": "America/New_York", "count": 3});
        list<string> dates = [];
        for (item in schedule.occurrences(3)) { dates.push(item.formatRFC3339()); }
        this.assertEquals(["2024-03-09T07:30:00Z", "2024-03-10T07:00:00Z",
            "2024-03-11T06:30:00Z"], dates);
    }

    @test
    func keepsPeriodFieldsImmutable(): void {
        let value = period.Period(1, 2, 3);
        bool failed = false;
        try { value.days = 9; }
        catch (ImmutableError e) { failed = true; }
        this.assertTrue(failed);
        this.assertEquals(3, value.days);
        let schedule = period.Recurrence(datetime.Instant(0), "weekly", {"weekdays": [1]});
        bool listFailed = false;
        try { schedule.weekdays.push(2); }
        catch (ImmutableError e) { listFailed = true; }
        this.assertTrue(listFailed);
    }
}
