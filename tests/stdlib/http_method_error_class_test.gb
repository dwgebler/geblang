/**
 * @title Network error classes from HTTP client methods (1.42.2)
 * @summary Client and Builder methods raise IOError for a refused
 * connection and TimeoutError (an IOError) for a timeout, on both
 * backends.
 *
 * Tagged "integration" (binds local ports).
 */
import test;
import http;
import async;

class HttpMethodErrorClassTest extends test.Test {
    func classOf(callable f): string {
        try {
            f();
            return "returned";
        } catch (Error e) {
            return "${typeof(e)}";
        }
    }

    @tag("integration")
    @test
    func refusedConnectionsRaiseIOError(): void {
        let c = http.newClient({});
        this.assertEquals("IOError", this.classOf(func(): void { c.get("http://127.0.0.1:1/"); }));
        this.assertEquals("IOError", this.classOf(func(): void { http.request("http://127.0.0.1:1/").send(); }));
    }

    @tag("integration")
    @test
    func clientTimeoutRaisesTimeoutError(): void {
        let slow = http.listen("127.0.0.1:0", func(dict<string, any> r): dict<string, any> {
            await async.sleep(1000);
            return {"status": 200, "body": "late"};
        });
        let c = http.newClient({"timeoutMs": 200});
        let outcome = this.classOf(func(): void { c.get("http://${http.serverAddr(slow)}/"); });
        bool caughtAsIOError = false;
        try {
            c.get("http://${http.serverAddr(slow)}/");
        } catch (IOError e) {
            caughtAsIOError = true;
        }
        http.close(slow);
        this.assertEquals("TimeoutError", outcome);
        this.assertTrue(caughtAsIOError);
    }
}
