/**
 * @title list.slice returns a new list (1.38.0)
 * @summary Writing to or growing a slice never changes the list it came from.
 */
import test;

class ListSliceTest extends test.Test {
    @test
    func elementWritesStayInTheSlice(): void {
        list<string> a = ["a", "b", "c", "d"];
        let s = a.slice(1, 3);
        s[0] = "X";
        this.assertEquals(["a", "b", "c", "d"], a);
        this.assertEquals(["X", "c"], s);
    }

    @test
    func pushingToASliceLeavesTheOriginal(): void {
        list<int> a = [1, 2, 3, 4];
        let s = a.slice(0, 2);
        s.push(9);
        this.assertEquals([1, 2, 3, 4], a);
        this.assertEquals([1, 2, 9], s);
    }

    @test
    func openEndedSliceIsAlsoACopy(): void {
        list<int> a = [1, 2, 3];
        let s = a.slice(1);
        s[1] = 7;
        this.assertEquals([1, 2, 3], a);
    }
}
