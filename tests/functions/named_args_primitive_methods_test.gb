/**
 * @title Named arguments on primitive methods
 * @summary Methods on lists, strings and dicts bind named arguments by
 * their documented parameter names; an unknown name raises the same
 * error on both runtimes.
 */
import test;

class NamedArgsPrimitiveMethodsTest extends test.Test {
    func failure(func call): string {
        try {
            call();
        } catch (Error e) {
            return e.message;
        }
        return "no error";
    }

    @test
    func listMethodBindsNamedArgs(): void {
        let xs = [1, 2, 3];
        this.assertEquals(6, xs.reduce(combine: func(int a, int b): int { return a + b; }, initial: 0));
        any dyn = xs;
        this.assertEquals("list.reduce has no parameter fn", this.failure(func(): void {
            dyn.reduce(fn: func(int a, int b): int { return a + b; }, initial: 0);
        }));
    }

    @test
    func stringMethodBindsNamedArgs(): void {
        this.assertEquals(["a", "b"], "a,b".split(separator: ","));
        any dyn = "a,b";
        this.assertEquals("string.split has no parameter sep", this.failure(func(): void {
            dyn.split(sep: ",");
        }));
    }

    @test
    func dictMethodBindsNamedArgs(): void {
        let d = {"k": 1};
        this.assertEquals(1, d.get(key: "k"));
    }

    @test
    func positionalCallsStillWork(): void {
        let xs = [1, 2, 3];
        this.assertEquals(16, xs.reduce(func(int a, int b): int { return a + b; }, 10));
    }
}
