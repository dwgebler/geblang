/**
 * @title Integer literal arguments take float/decimal parameter types (1.37.1)
 * @summary An integer literal passed where a float or decimal parameter is
 * declared is typed as that parameter, as declarations and returns already
 * are, for functions, constructors, static methods, and methods on a receiver
 * of known class. An exact int overload still wins.
 */
import test;

func half(float x): float { return x / 2.0f; }
func price(decimal amount): decimal { return amount; }
func pick(int x): string { return "int"; }
func pick(float x): string { return "float"; }

class Meter {
    float reading;

    func Meter(float reading) {
        this.reading = reading;
    }

    func scale(float factor): float {
        return this.reading * factor;
    }

    static func zero(float offset): Meter {
        return Meter(offset);
    }
}

func mixed(int x, float y): string { return "int-float"; }
func mixed(float x, float y): string { return "float-float"; }
func named(string label, float x = 0.5f): string { return typeof(x) as string; }
func halfAgain(): float { return half(-3); }

class Scaled extends Meter {
    func Scaled() {
        parent(4);
    }

    func scale(float factor): float {
        return parent.scale(-1);
    }
}

class Holder<T> {
    T item;

    func Holder(T item) {
        this.item = item;
    }

    func put(T item): void {
        this.item = item;
    }
}

class Picker {
    func m(float x): string { return "mf"; }
    func m(string x): string { return "ms"; }
    static func t(decimal x): string { return "td"; }
    static func t(string x): string { return "ts"; }
}

class Shape {
    float v;

    func Shape(float v) { this.v = v; }
    func Shape(string s) { this.v = 0.0f; }
}

export class Circle {
    float r = 1.0f;

    func scale(float k): float { return this.r * k; }
    func doubled(): float { return this.scale(2); }
}

class Animal {
    func feed(float amount): string { return "Animal " + (typeof(amount) as string); }
}

class Dog extends Animal {
    func feed(int amount): string { return "Dog " + (typeof(amount) as string); }
}

func pickFn(float x): string { return "sf"; }
func pickFn(string x): string { return "ss"; }

class Gauge {
    float v;

    func Gauge(float v, string tag = "t") {
        this.v = v;
    }

    func scale(float f, int k = 1): float {
        return this.v * f;
    }
}

class FloatLeaf extends Holder<float> {
    func FloatLeaf() {
        parent(1);
    }

    func again(): void {
        parent.put(2);
    }
}

class OpenLeaf<U> extends Holder<U> {
    func OpenLeaf(U item) {
        parent(item);
    }

    func reset(): void {
        parent.put(4);
    }
}

class IntLiteralArgsTest extends test.Test {

    @test
    func conditionalLiterals(): void {
        bool on = true;
        float f = on ? 1 : 2;
        this.assertEquals("float", typeof(f) as string);
        this.assertEquals(2.0f, half(on ? 4 : 6));
    }

    @test
    func genericParameterLiterals(): void {
        let box = Holder<float>(1);
        this.assertEquals("float", typeof(box.item) as string);
        Holder<decimal> exact = Holder(2);
        this.assertEquals("decimal", typeof(exact.item) as string);
        box.put(3);
        this.assertEquals("float", typeof(box.item) as string);
    }

    @test
    func overloadedTargets(): void {
        this.assertEquals("sf", pickFn(2));
        this.assertEquals("mf", Picker().m(2));
        this.assertEquals("td", Picker.t(3));
        this.assertEquals("float", typeof(Shape(2).v) as string);
    }

    @test
    func exportedClassAndOverrides(): void {
        this.assertEquals(2.0f, Circle().doubled());
        Animal animal = Animal();
        Animal dog = Dog();
        this.assertEquals("Animal float", animal.feed(1));
        this.assertEquals("Dog int", dog.feed(1));
    }

    @test
    func negativeLiterals(): void {
        this.assertEquals(-1.5f, half(-3));
        float f = -1;
        decimal d = -2;
        this.assertEquals("float", typeof(f) as string);
        this.assertEquals("decimal", typeof(d) as string);
    }

    @test
    func parentConstructorAndMethod(): void {
        let scaled = Scaled();
        this.assertEquals("float", typeof(scaled.reading) as string);
        this.assertEquals(-4.0f, scaled.scale(9.0f));
    }

    @test
    func namedArgument(): void {
        this.assertEquals("float", named("a", x: 1));
        this.assertEquals("float", named(label: "a", x: -2));
    }

    @test
    func fewestConversionsWins(): void {
        this.assertEquals("int-float", mixed(1, 2));
        this.assertEquals("float-float", mixed(1.5f, 2));
    }

    @test
    func returnPosition(): void {
        this.assertEquals(-1.5f, halfAgain());
    }

    @test
    func functionParameter(): void {
        this.assertEquals("float", typeof(half(3)) as string);
        this.assertEquals(1.5f, half(3));
        this.assertEquals("decimal", typeof(price(4)) as string);
    }

    @test
    func constructorAndStaticMethod(): void {
        let meter = Meter(2);
        this.assertEquals("float", typeof(meter.reading) as string);
        this.assertEquals("float", typeof(Meter.zero(1).reading) as string);
    }

    @test
    func methodOnKnownReceiver(): void {
        let meter = Meter(2.0f);
        this.assertEquals(6.0f, meter.scale(3));
    }

    @test
    func exactIntOverloadWins(): void {
        this.assertEquals("int", pick(2));
        this.assertEquals("float", pick(2.0f));
    }

    @test
    func intVariableIsNotConverted(): void {
        any n = 3;
        this.assertThrowsOf(func(): void { half(n); }, "TypeError", "half expects float for parameter 'x', got int");
    }

    @test
    func namedMethodArgumentsInAnyOrder(): void {
        let gauge = Gauge(v: 2);
        this.assertEquals("float", typeof(gauge.v) as string);
        this.assertEquals(4.0f, gauge.scale(f: 2));
        this.assertEquals(6.0f, gauge.scale(k: 1, f: 3));
    }

    @test
    func parentCallsIntoExtendsBoundParameter(): void {
        let leaf = FloatLeaf();
        this.assertEquals("float", typeof(leaf.item) as string);
        leaf.again();
        this.assertEquals("float", typeof(leaf.item) as string);
        let open = OpenLeaf<decimal>(1.5);
        open.reset();
        this.assertEquals("decimal", typeof(open.item) as string);
    }
}
