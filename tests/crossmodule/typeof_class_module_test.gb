/**
 * @title Cross-module Type-vs-Class equality is name-only
 * @summary typeof(instance) carries only a name, so a class value and a typeof
 * of the same name compare equal via == and assertEquals even across modules,
 * while two class values (module-aware) do not. Pins the current == contract.
 */
import test;
import cfgdonor;

class Config {}

class TypeofClassModuleTest extends test.Test {
    @test
    func typeVsClassNameOnly(): void {
        let localInst = Config();
        let remoteInst = cfgdonor.makeConfig();
        let remoteClass = cfgdonor.configClass();

        this.assertEquals(Config, typeof(remoteInst));
        this.assertEquals(remoteClass, typeof(localInst));
        this.assertTrue(Config == typeof(remoteInst));
        this.assertTrue(remoteClass == typeof(localInst));
    }

    @test
    func classVsClassModuleAware(): void {
        let remoteClass = cfgdonor.configClass();
        this.assertFalse(Config == remoteClass);
    }
}
