import io;
import sys;

let args = sys.args();
int n = args.length() > 0 ? args[0].toInt() : 500000;
let s = "hello world";
let xs = [1, 2, 3, 4];
let d = {"a": 1, "b": 2};
int total = 0;
for (int i = 0; i < n; i++) {
    total = total + s.length() + xs.length() + (d.get("a") as int);
}
io.println(total);
