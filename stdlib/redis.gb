module redis;

import bytes;
import net;

# Reject an implausible bulk length instead of allocating toward the deadline (Redis proto-max-bulk-len default).
let MAX_BULK_BYTES = 536870912;

func encodeCommand(list<string> parts): string {
    string out = "*" + (parts.length() as string) + "\r\n";
    for (part in parts) {
        string value = part as string;
        out = out + "$" + (value.length() as string) + "\r\n" + value + "\r\n";
    }
    return out;
}

# Valid UTF-8 bulk strings decode to text; binary stays raw bytes.
func decodeBulk(bytes raw): any {
    try {
        return bytes.toString(raw);
    } catch {
        return raw;
    }
}

func requireStringValue(any value): any {
    if (value instanceof bytes) {
        throw RuntimeError("redis value is not valid UTF-8; use getBytes to read it as raw bytes");
    }
    return value;
}

## Reads one RESP reply from a `source` func(): bytes that yields byte chunks.
export func decodeReply(any source): any {
    let reader = RespReader(source);
    return reader.readReply();
}

# Byte-level RESP reader; frames by length prefix so binary and split values parse.
class RespReader {
    any source;
    bytes buf;
    int pos;
    list<bytes> pending;
    int pendingLen;
    bool rawBulk;

    func RespReader(any source) {
        this.source = source;
        this.buf = bytes.fromString("");
        this.pos = 0;
        this.pending = [];
        this.pendingLen = 0;
        this.rawBulk = false;
    }

    func fill(): bool {
        let pull = this.source;
        let chunk = pull() as bytes;
        if (chunk.isEmpty()) {
            return false;
        }
        this.pending.push(chunk);
        this.pendingLen = this.pendingLen + chunk.length();
        return true;
    }

    # Drops consumed bytes and folds queued chunks in one concat: linear, not per-chunk quadratic copying.
    func materialize(): void {
        if (this.pendingLen == 0) {
            return;
        }
        this.buf = bytes.concat(this.buf.slice(this.pos, this.buf.length()), ...this.pending);
        this.pos = 0;
        this.pending = [];
        this.pendingLen = 0;
    }

    func ensure(int n): void {
        while (((this.buf.length() - this.pos) + this.pendingLen) < n) {
            if (!this.fill()) {
                throw RuntimeError("redis: connection closed before a full reply arrived");
            }
        }
        this.materialize();
    }

    func readLine(): bytes {
        int off = 0;  # relative to this.pos, since materialize() can reset this.pos to 0
        while (true) {
            if ((this.pos + off + 1) >= this.buf.length()) {
                if (!this.fill()) {
                    throw RuntimeError("redis: connection closed before end of line");
                }
                this.materialize();
                continue;
            }
            if (this.buf.get(this.pos + off) == 13 && this.buf.get(this.pos + off + 1) == 10) {
                let line = this.buf.slice(this.pos, this.pos + off);
                this.pos = this.pos + off + 2;
                return line;
            }
            off = off + 1;
        }
    }

    func readReply(): any {
        this.ensure(1);
        int kind = this.buf.get(this.pos);
        this.pos = this.pos + 1;
        let line = this.readLine();
        if (kind == 43) {                              # '+' simple string
            return line.toString();
        }
        if (kind == 45) {                              # '-' error
            throw RuntimeError(line.toString());
        }
        if (kind == 58) {                              # ':' integer
            return line.toString() as int;
        }
        if (kind == 36) {                              # '$' bulk string
            int len = line.toString() as int;
            if (len < 0) {
                return null;
            }
            if (len > MAX_BULK_BYTES) {
                throw RuntimeError("redis: bulk reply length exceeds the ${MAX_BULK_BYTES} byte limit");
            }
            this.ensure(len + 2);
            let payload = this.buf.slice(this.pos, this.pos + len);
            this.pos = this.pos + len + 2;
            if (this.rawBulk) {
                return payload;
            }
            return decodeBulk(payload);
        }
        if (kind == 42) {                              # '*' array
            int count = line.toString() as int;
            if (count < 0) {
                return null;
            }
            list<any> values = [];
            for (let i = 0; i < count; i = i + 1) {
                values.push(this.readReply());
            }
            return values;
        }
        return line.toString();
    }
}

## Minimal Redis client for strings, lists, sets, hashes, counters, expiry, and raw commands.
export class Client {
    any conn;

    func Client(string address) {
        this.conn = net.connectTcp(address);
        net.setDeadline(this.conn, 5000);
    }

    # raw skips bulk-string UTF-8 decode/re-encode, for callers that want the payload as bytes.
    func command(list<string> parts, bool raw = false): any {
        net.write(this.conn, encodeCommand(parts));
        let conn = this.conn;
        let reader = RespReader(func(): bytes {
            return net.read(conn, 65536) as bytes;
        });
        reader.rawBulk = raw;
        return reader.readReply();
    }

    func ping(): bool {
        return (this.command(["PING"]) as string) == "PONG";
    }

    func auth(string password): bool {
        return (this.command(["AUTH", password]) as string) == "OK";
    }

    func select(int database): bool {
        return (this.command(["SELECT", database as string]) as string) == "OK";
    }

    func get(string key): any {
        return requireStringValue(this.command(["GET", key]));
    }

    ## Fetches a key as raw bytes; use for binary values that are not valid UTF-8.
    func getBytes(string key): ?bytes {
        let value = this.command(["GET", key], true);
        if (value == null) {
            return null;
        }
        if (value instanceof bytes) {
            return value as bytes;
        }
        return bytes.fromString(value as string);
    }

    func set(string key, string value): bool {
        return (this.command(["SET", key, value]) as string) == "OK";
    }

    func del(string key): int {
        return this.command(["DEL", key]) as int;
    }

    func exists(string key): bool {
        return (this.command(["EXISTS", key]) as int) > 0;
    }

    func expire(string key, int seconds): bool {
        return (this.command(["EXPIRE", key, seconds as string]) as int) == 1;
    }

    func incr(string key): int {
        return this.command(["INCR", key]) as int;
    }

    func ttl(string key): int {
        return this.command(["TTL", key]) as int;
    }

    func lpush(string key, string value): int {
        return this.command(["LPUSH", key, value]) as int;
    }

    func rpush(string key, string value): int {
        return this.command(["RPUSH", key, value]) as int;
    }

    func lpop(string key): any {
        return this.command(["LPOP", key]);
    }

    func rpop(string key): any {
        return this.command(["RPOP", key]);
    }

    func lrange(string key, int start, int stop): list<any> {
        return this.command(["LRANGE", key, start as string, stop as string]) as list<any>;
    }

    func sadd(string key, string member): int {
        return this.command(["SADD", key, member]) as int;
    }

    func srem(string key, string member): int {
        return this.command(["SREM", key, member]) as int;
    }

    func sismember(string key, string member): bool {
        return (this.command(["SISMEMBER", key, member]) as int) == 1;
    }

    func smembers(string key): list<any> {
        return this.command(["SMEMBERS", key]) as list<any>;
    }

    func hset(string key, string field, string value): int {
        return this.command(["HSET", key, field, value]) as int;
    }

    func hget(string key, string field): any {
        return this.command(["HGET", key, field]);
    }

    func hdel(string key, string field): int {
        return this.command(["HDEL", key, field]) as int;
    }

    func hgetAll(string key): dict<string, any> {
        let values = this.command(["HGETALL", key]) as list<any>;
        dict<string, any> out = {};
        int i = 0;
        while ((i + 1) < values.length()) {
            out[values[i] as string] = values[i + 1];
            i = i + 2;
        }
        return out;
    }

    func setex(string key, int seconds, string value): bool {
        return (this.command(["SETEX", key, seconds as string, value]) as string) == "OK";
    }

    func eval(string script, list<string> keys, list<string> args): any {
        list<string> parts = ["EVAL", script, keys.length() as string];
        for (k in keys) { parts.push(k); }
        for (a in args) { parts.push(a); }
        return this.command(parts);
    }

    func close(): void {
        net.close(this.conn);
    }
}

## Connects to a Redis server address and returns a Client.
export func connect(string address): Client {
    return Client(address);
}
