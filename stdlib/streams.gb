module streams;

import collections;
import bytes;
import io;
import reflect;
import strings;

## Stream wraps any iterable (list, set, generator, range, or another
## class with the 1.0.6 iterator protocol) and exposes a fluent,
## lazy-by-default API. Intermediate steps (`map`, `filter`, `take`)
## return a new Stream that pulls values on demand; terminal steps
## (`toList`, `count`, `reduce`, `forEach`, `first`, `anyMatch`,
## `allMatch`, `toSet`) materialise the pipeline.
##
## Streams implement `__iter()` so they slot directly into
## `for (x in stream)` loops and anywhere an `iterable<T>` is
## expected.
export class Stream {
    any source;

    func Stream(any source) {
        this.source = source;
    }

    ## Intermediate: maps each value through `fn`. Applied lazily.
    func map(any fn): Stream {
        return Stream(collections.lazyMap(this.source, fn));
    }

    ## Intermediate: keeps values for which `fn` returns true.
    ## Applied lazily.
    func filter(any fn): Stream {
        return Stream(collections.lazyFilter(this.source, fn));
    }

    ## Intermediate: yields at most the first `n` values.
    func take(int n): Stream {
        return Stream(collections.take(this.source, n));
    }

    ## Iterator-protocol entry point: forwards iteration to the
    ## wrapped source so `for (x in stream)` walks the pipeline
    ## without materialising it.
    func __iter(): any {
        return this.source;
    }

    ## Terminal: materialises the pipeline into a list.
    func toList(): list<any> {
        list<any> result = [];
        for (x in this.source) {
            result = result.push(x);
        }
        return result;
    }

    ## Terminal: materialises the pipeline into a set. Duplicates
    ## collapse.
    func toSet(): set<any> {
        set<any> result = [] as set<any>;
        for (x in this.source) {
            result = result.add(x);
        }
        return result;
    }

    ## Terminal: counts values produced by the pipeline.
    func count(): int {
        int n = 0;
        for (x in this.source) {
            n = n + 1;
        }
        return n;
    }

    ## Terminal: returns the first value, or null when empty.
    func first(): any {
        for (x in this.source) {
            return x;
        }
        return null;
    }

    ## Terminal: invokes `fn(value)` for each value.
    func forEach(any fn): void {
        for (x in this.source) {
            fn(x);
        }
    }

    ## Terminal: folds the pipeline left-to-right starting from
    ## `initial`. `fn(accumulator, value)` returns the next
    ## accumulator.
    func reduce(any initial, any fn): any {
        any acc = initial;
        for (x in this.source) {
            acc = fn(acc, x);
        }
        return acc;
    }

    ## Terminal: true when at least one value satisfies `fn`.
    func anyMatch(any fn): bool {
        for (x in this.source) {
            if ((fn(x) as bool)) {
                return true;
            }
        }
        return false;
    }

    ## Terminal: true when every value satisfies `fn` (vacuously true
    ## for an empty pipeline).
    func allMatch(any fn): bool {
        for (x in this.source) {
            if (!(fn(x) as bool)) {
                return false;
            }
        }
        return true;
    }
}

## Wraps any iterable in a Stream for fluent chaining.
export func of(any source): Stream {
    return Stream(source);
}

## IOStream wraps a low-level handle (file, in-memory buffer,
## stdin / stdout / stderr) in the F3 stream protocol. Methods:
## `read` / `readAll` / `readLine` / `lines` / `write` / `writeln`
## / `flush` / `close` / `isClosed`. Memory-backed instances also
## expose `toString()`; non-memory handles raise on that call.
##
## Iterating a stream yields lines:
## `for (line in stream) { ... }`. Implements the protocol dunders
## `__read` / `__write` / `__close` so helpers like
## `streams.copy` / `streams.readAll` consume it without going
## through the named methods.
export class IOStream {
    any handle;
    bool _closed;

    func IOStream(any handle) {
        this.handle = handle;
        this._closed = false;
    }

    ## Reads up to `n` bytes from the stream. Returns the empty
    ## string at EOF.
    func read(int n): string {
        return io.read(this.handle, n);
    }

    func readBytes(int n): bytes {
        return io.readBytes(this.handle, n);
    }

    ## Reads the entire remaining contents of the stream into a
    ## single string.
    func readAll(): string {
        return io.readAll(this.handle);
    }

    ## Reads the next line with the trailing `\n` (or `\r\n`)
    ## stripped. Returns null at EOF.
    func readLine(): ?string {
        return io.readLine(this.handle);
    }

    ## Lazy generator yielding each line until EOF.
    func lines(): generator<string> {
        while (true) {
            let line = io.readLine(this.handle);
            if (line == null) {
                break;
            }
            yield line as string;
        }
    }

    ## Writes `buf` and returns the number of bytes written.
    func write(string buf): int {
        return io.write(this.handle, buf);
    }

    func writeBytes(bytes data): int {
        return io.writeBytes(this.handle, data);
    }

    ## Writes `buf` followed by a newline.
    func writeln(string buf): int {
        return io.writeln(this.handle, buf);
    }

    ## Repositions a seekable (file-backed) stream; whence is "start",
    ## "current", or "end". Returns the new offset. Raises on memory and
    ## standard streams.
    func seek(int offset, string whence = "start"): int {
        return io.seek(this.handle, offset, whence);
    }

    ## Current byte offset of a seekable (file-backed) stream.
    func tell(): int {
        return io.tell(this.handle);
    }

    ## Resizes a file-backed stream to `size` bytes.
    func truncate(int size): void {
        io.truncate(this.handle, size);
    }

    ## Whether a file-backed stream is at end-of-file.
    func atEnd(): bool {
        return io.atEnd(this.handle);
    }

    ## Flushes any buffered output.
    func flush(): void {
        io.flush(this.handle);
    }

    ## Closes the underlying resource. Safe to call more than once.
    func close(): void {
        if (this._closed) {
            return;
        }
        io.close(this.handle);
        this._closed = true;
    }

    ## True after `close()` has been called.
    func isClosed(): bool {
        return this._closed;
    }

    ## Returns the full buffer contents of a memory-backed stream
    ## without moving the read cursor. Raises on file / stdin /
    ## stdout / stderr handles.
    func toString(): string {
        return io.toString(this.handle);
    }

    func __read(int n): string {
        return io.read(this.handle, n);
    }

    func __write(string buf): int {
        return io.write(this.handle, buf);
    }

    func __readBytes(int n): bytes {
        return io.readBytes(this.handle, n);
    }

    func __writeBytes(bytes data): int {
        return io.writeBytes(this.handle, data);
    }

    func __close(): void {
        this.close();
    }

    func __iter(): any {
        return this.lines();
    }
}

## Opens a file and wraps it in an IOStream. `mode` accepts the
## same strings as `io.open` (e.g. `"r"`, `"w"`, `"a"`, `"r+"`).
export func open(string path, string mode = "r"): IOStream {
    return IOStream(io.open(path, mode));
}

## Returns an IOStream backed by an in-memory buffer. The optional
## `initial` argument seeds the buffer; reads pull from the seed
## first, then from anything subsequently written. Memory-backed
## streams support `toString()` for inspection.
export func memory(string initial = ""): IOStream {
    if (initial == "") {
        return IOStream(io.memory());
    }
    return IOStream(io.memory(initial));
}

## Wraps stdin in an IOStream.
export func stdin(): IOStream {
    return IOStream(io.stdin());
}

## Wraps stdout in an IOStream.
export func stdout(): IOStream {
    return IOStream(io.stdout());
}

## Wraps stderr in an IOStream.
export func stderr(): IOStream {
    return IOStream(io.stderr());
}

## Reads everything from `src` (anything with a `__read(int)`
## method) until EOF and returns the accumulated string.
export func readAll(any src, int chunk = 4096): string {
    let sb = strings.StringBuilder();
    while (true) {
        string part = src.__read(chunk);
        if (part == "") {
            break;
        }
        sb.append(part);
    }
    let result = sb.build();
    sb.dispose();
    return result;
}

## Pipes everything from `src.__read(chunk)` into `dst.__write(...)`
## until `src` returns EOF. Returns the total number of bytes
## transferred (as reported by `dst.__write`).
func readChunk(any src, int n): bytes {
    let binary = reflect.method(src, "__readBytes");
    bytes data;
    if (binary != null) {
        data = binary(n) as bytes;
    } else {
        data = bytes.fromString(src.__read(n) as string);
    }
    if (data.length() > n) {
        throw ValueError("streams: source returned more bytes than requested");
    }
    return data;
}

func writeChunk(any dst, bytes data): int {
    let binary = reflect.method(dst, "__writeBytes");
    int written;
    if (binary != null) {
        written = binary(data) as int;
    } else {
        written = dst.__write(bytes.rawString(data)) as int;
    }
    if (written < 0 || written > data.length()) {
        throw ValueError("streams: invalid write count");
    }
    return written;
}

func writeFully(any dst, bytes data): int {
    int written = 0;
    while (written < data.length()) {
        int count = writeChunk(dst, data.slice(written));
        if (count == 0) { throw IOError("streams: write made no progress"); }
        written = written + count;
    }
    return written;
}

func flushStream(any target): void {
    let method = reflect.method(target, "flush");
    if (method != null) { method(); }
}

func closeStream(any target): void {
    let method = reflect.method(target, "__close");
    if (method != null) { method(); }
}

export class LimitedStream {
    any source;
    int remaining;
    bool closeUnderlying;
    bool closed;

    func LimitedStream(any source, int maxBytes, bool closeUnderlying) {
        if (maxBytes < 0) { throw ValueError("streams.limit: maxBytes must be nonnegative"); }
        this.source = source;
        this.remaining = maxBytes;
        this.closeUnderlying = closeUnderlying;
        this.closed = false;
    }

    func readBytes(int n): bytes {
        if (this.closed) { throw IOError("streams.limit: closed"); }
        if (n < 0) { throw ValueError("streams.limit: read size must be nonnegative"); }
        if (n == 0 || this.remaining == 0) { return bytes.fromString(""); }
        int count = n;
        if (count > this.remaining) { count = this.remaining; }
        bytes data = readChunk(this.source, count);
        this.remaining = this.remaining - data.length();
        return data;
    }

    func read(int n): string { return bytes.rawString(this.readBytes(n)); }
    func __read(int n): string { return this.read(n); }
    func __readBytes(int n): bytes { return this.readBytes(n); }
    func write(string data): int { throw IOError("streams.limit: read-only"); }
    func writeBytes(bytes data): int { throw IOError("streams.limit: read-only"); }
    func __write(string data): int { return this.write(data); }
    func __writeBytes(bytes data): int { return this.writeBytes(data); }
    func flush(): void {}
    func close(): void {
        if (this.closed) { return; }
        this.closed = true;
        if (this.closeUnderlying) { closeStream(this.source); }
    }
    func __close(): void { this.close(); }
}

export func limit(any source, int maxBytes, bool closeUnderlying = true): LimitedStream {
    return LimitedStream(source, maxBytes, closeUnderlying);
}

export class BufferedStream {
    any source;
    int size;
    bool closeUnderlying;
    bool closed;
    bytes pendingRead;
    bytes pendingWrite;

    func BufferedStream(any source, int size, bool closeUnderlying) {
        if (size <= 0) { throw ValueError("streams.buffer: size must be positive"); }
        this.source = source;
        this.size = size;
        this.closeUnderlying = closeUnderlying;
        this.closed = false;
        this.pendingRead = bytes.fromString("");
        this.pendingWrite = bytes.fromString("");
    }

    func readBytes(int n): bytes {
        if (this.closed) { throw IOError("streams.buffer: closed"); }
        if (n < 0) { throw ValueError("streams.buffer: read size must be nonnegative"); }
        if (n == 0) { return bytes.fromString(""); }
        bytes output = bytes.fromString("");
        while (output.length() < n) {
            if (this.pendingRead.length() == 0) {
                this.pendingRead = readChunk(this.source, this.size);
                if (this.pendingRead.length() == 0) { break; }
            }
            int count = n - output.length();
            if (count > this.pendingRead.length()) { count = this.pendingRead.length(); }
            output = bytes.concat(output, this.pendingRead.slice(0, count));
            this.pendingRead = this.pendingRead.slice(count);
        }
        return output;
    }

    func read(int n): string { return bytes.rawString(this.readBytes(n)); }
    func __read(int n): string { return this.read(n); }
    func __readBytes(int n): bytes { return this.readBytes(n); }

    func writeBytes(bytes data): int {
        if (this.closed) { throw IOError("streams.buffer: closed"); }
        this.pendingWrite = bytes.concat(this.pendingWrite, data);
        if (this.pendingWrite.length() >= this.size) { this.flush(); }
        return data.length();
    }

    func write(string data): int { return this.writeBytes(bytes.fromString(data)); }
    func __write(string data): int { return this.write(data); }
    func __writeBytes(bytes data): int { return this.writeBytes(data); }

    func flush(): void {
        if (this.closed) { throw IOError("streams.buffer: closed"); }
        while (this.pendingWrite.length() > 0) {
            int written = writeChunk(this.source, this.pendingWrite);
            if (written == 0) { throw IOError("streams.buffer: write made no progress"); }
            this.pendingWrite = this.pendingWrite.slice(written);
        }
        flushStream(this.source);
    }

    func close(): void {
        if (this.closed) { return; }
        this.flush();
        this.closed = true;
        if (this.closeUnderlying) { closeStream(this.source); }
    }
    func __close(): void { this.close(); }
}

export func buffer(any source, int size = 8192, bool closeUnderlying = true): BufferedStream {
    return BufferedStream(source, size, closeUnderlying);
}

export class TeeStream {
    any source;
    any sink;
    bool closeUnderlying;
    bool closed;
    bool failed;

    func TeeStream(any source, any sink, bool closeUnderlying) {
        this.source = source;
        this.sink = sink;
        this.closeUnderlying = closeUnderlying;
        this.closed = false;
        this.failed = false;
    }

    func readBytes(int n): bytes {
        if (this.closed || this.failed) { throw IOError("streams.tee: closed or failed"); }
        if (n < 0) { throw ValueError("streams.tee: read size must be nonnegative"); }
        bytes data = readChunk(this.source, n);
        if (data.length() > 0) {
            try { writeFully(this.sink, data); }
            catch (Error e) { this.failed = true; throw e; }
        }
        return data;
    }

    func read(int n): string { return bytes.rawString(this.readBytes(n)); }
    func __read(int n): string { return this.read(n); }
    func __readBytes(int n): bytes { return this.readBytes(n); }
    func write(string data): int { throw IOError("streams.tee: read-only"); }
    func writeBytes(bytes data): int { throw IOError("streams.tee: read-only"); }
    func __write(string data): int { return this.write(data); }
    func __writeBytes(bytes data): int { return this.writeBytes(data); }
    func flush(): void { flushStream(this.sink); }
    func close(): void {
        if (this.closed) { return; }
        this.closed = true;
        flushStream(this.sink);
        if (this.closeUnderlying) {
            closeStream(this.source);
            closeStream(this.sink);
        }
    }
    func __close(): void { this.close(); }
}

export func tee(any source, any sink, bool closeUnderlying = true): TeeStream {
    return TeeStream(source, sink, closeUnderlying);
}

export func copyN(any src, any dst, int maxBytes, int chunk = 8192): int {
    if (maxBytes < 0 || chunk <= 0) { throw ValueError("streams.copyN: invalid size"); }
    int total = 0;
    while (total < maxBytes) {
        int count = chunk;
        if (count > maxBytes - total) { count = maxBytes - total; }
        bytes data = readChunk(src, count);
        if (data.length() == 0) { break; }
        total = total + writeFully(dst, data);
    }
    return total;
}

export func copy(any src, any dst, int chunk = 4096): int {
    if (chunk <= 0) { throw ValueError("streams.copy: chunk must be positive"); }
    int total = 0;
    while (true) {
        bytes part = readChunk(src, chunk);
        if (part.length() == 0) { break; }
        total = total + writeFully(dst, part);
    }
    return total;
}
